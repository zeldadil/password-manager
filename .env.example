# Password Manager — environment example
#
# All values here are SYNTHETIC — never commit real secrets. The API runs with
# sensible defaults, so you only need this file to override them.
#
# NOTHING in the repository loads this file automatically (no dotenv, no
# --env-file). To use it, copy it and export its variables into your shell,
# from the repository root, before running any pnpm command:
#
#   cp .env.example .env.local      # then edit .env.local
#   set -a; . ./.env.local; set +a  # export every variable it defines
#   pnpm dev
#
# The exported values only apply to that shell session.

# --- API (apps/services/api) ---
# TCP port to listen on (default 3000)
PORT=3000
# Interface to bind (default 127.0.0.1)
HOST=127.0.0.1
# development | test | production
NODE_ENV=development

# --- Database ---
# V1 uses SQLite for local development. PostgreSQL is the production target.
# Plain SQLite FILE PATH (not a `file:` URL — `file:./dev.db` makes
# better-sqlite3 fail to open the database). Relative paths are resolved from
# apps/services/api, where pnpm runs the API scripts. Default if unset: ./dev.db
DATABASE_URL=./dev.db

# --- Vault / session ---
# Auto-lock idle timeout in milliseconds (default 15 minutes = 900000)
AUTO_LOCK_TIMEOUT_MS=900000
