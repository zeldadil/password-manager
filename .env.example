# Password Manager — environment example
#
# Copy to `.env.local` (or `.env`) and adjust. All values here are SYNTHETIC —
# never commit real secrets. The API runs with sensible defaults, so most
# developers only need to set what they override.

# --- API (apps/services/api) ---
# TCP port to listen on (default 3000)
PORT=3000
# Interface to bind (default 127.0.0.1)
HOST=127.0.0.1
# development | test | production
NODE_ENV=development

# --- Database ---
# V1 uses SQLite for local development. PostgreSQL is the production target.
# Defaults to a local SQLite file if unset.
DATABASE_URL=file:./dev.db

# --- Vault / session ---
# Auto-lock idle timeout in milliseconds (default 15 minutes = 900000)
AUTO_LOCK_TIMEOUT_MS=900000
